<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- NoActionBar because we use a Toolbar widget as ActionBar -->
    <style name="KdeConnectThemeBase" parent="Theme.Material3Expressive.DynamicColors.DayNight.NoActionBar">
        <item name="android:windowBackground">?attr/colorSurface</item>
        <item name="preferenceTheme">@style/NearoPreferenceTheme</item>
        <item name="sliderStyle">@style/Widget.Material3Expressive.Slider.Small</item>
        <item name="toolbarStyle">@style/KdeConnectTheme.Toolbar</item>

        <item name="materialCardViewStyle">@style/KdeConnectCardStyle</item>

        <!-- https://github.com/material-components/material-components-android/issues/2732 -->
        <item name="alertDialogTheme">@style/KdeConnectDialogStyle</item>

        <item name="actionOverflowMenuStyle">@style/KdeConnectOverflowMenuStyle</item>
    </style>

    <!-- Show the overflow menu below the "three dots" button instead of on top of it, like the Compose menus -->
    <style name="KdeConnectOverflowMenuStyle" parent="Widget.Material3.PopupMenu.Overflow">
        <item name="overlapAnchor">false</item>
    </style>

    <style name="KdeConnectTheme" parent="KdeConnectThemeBase" />

    <style name="KdeConnectThemeBase.NoActionBar" parent="KdeConnectTheme">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="KdeConnectTheme.NoActionBar" parent="KdeConnectThemeBase.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">?attr/isLightTheme</item>
    </style>

    <style name="KdeConnectTheme.Toolbar" parent="Widget.Material3Expressive.Toolbar">
        <item name="titleTextAppearance">?attr/textAppearanceTitleLarge</item>
        <item name="subtitleTextAppearance">?attr/textAppearanceLabelLarge</item>
    </style>

    <style name="KdeConnectDialogStyle" parent="ThemeOverlay.Material3Expressive.MaterialAlertDialog">
        <item name="android:layout" tools:ignore="PrivateResource">@layout/m3_alert_dialog</item>
        <item name="dialogCornerRadius" tools:ignore="PrivateResource">@dimen/m3_alert_dialog_corner_size</item>
    </style>

    <style name="KdeConnectCardStyle" parent="Widget.Material3.CardView.Filled">
        <item name="cardCornerRadius">24dp</item>
    </style>

    <style name="KdeConnectCardStyle.Filled" parent="KdeConnectCardStyle"/>

    <style name="NearoPreferenceTheme" parent="PreferenceThemeOverlay">
        <item name="preferenceStyle">@style/NearoPreference</item>
        <item name="dialogPreferenceStyle">@style/NearoDialogPreference</item>
        <item name="editTextPreferenceStyle">@style/NearoEditTextPreference</item>
        <item name="switchPreferenceStyle">@style/NearoSwitchPreference</item>
        <item name="preferenceCategoryStyle">@style/NearoPreferenceCategory</item>
        <item name="preferenceFragmentCompatStyle">@style/NearoPreferenceFragment</item>
    </style>

    <style name="NearoPreference" parent="Preference.Material">
        <item name="android:layout">@layout/nearo_preference</item>
        <item name="iconSpaceReserved">false</item>
    </style>

    <style name="NearoDialogPreference" parent="Preference.DialogPreference.Material">
        <item name="android:layout">@layout/nearo_preference</item>
        <item name="iconSpaceReserved">false</item>
    </style>

    <style name="NearoEditTextPreference" parent="Preference.DialogPreference.EditTextPreference.Material">
        <item name="android:layout">@layout/nearo_preference</item>
        <item name="iconSpaceReserved">false</item>
    </style>

    <style name="NearoSwitchPreference" parent="Preference.SwitchPreference.Material">
        <item name="android:layout">@layout/nearo_preference</item>
        <item name="android:widgetLayout">@layout/preference_widget_material_switch</item>
        <item name="iconSpaceReserved">false</item>
    </style>

    <style name="NearoPreferenceCategory" parent="Preference.Category.Material">
        <item name="android:layout">@layout/nearo_preference_category</item>
    </style>

    <style name="NearoPreferenceFragment" parent="PreferenceFragment.Material">
        <item name="android:divider">@null</item>
    </style>

    <style name="KdeConnectButton.IconButton" parent="Widget.Material3Expressive.Button.IconButton.Filled">
        <item name="iconGravity">textStart</item>
        <item name="cornerRadius">24dp</item>
    </style>

    <style name="KdeConnectButton.IconButton.Secondary" parent="Widget.Material3Expressive.Button.IconButton.Tonal">
        <item name="iconGravity">textStart</item>
        <item name="cornerRadius">18dp</item>
    </style>

    <style name="ActionModeStyle" parent="Widget.AppCompat.ActionMode">
    </style>
    <style name="Theme.Transparent" parent="@style/Theme.AppCompat.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>

    <style name="AboutButton">
        <item name="android:layout_width">84dp</item>
        <item name="android:layout_height">84dp</item>
        <item name="android:layout_margin">4dp</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
    </style>
    <style name="AboutButton.TextView">
        <item name="android:layout_width">84dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_gravity">center</item>
        <item name="android:drawablePadding">4dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">12sp</item>
    </style>
    <style name="RemoteInputClickButton" parent="Widget.Material3Expressive.Button.TonalButton">
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:layout_marginLeft">2dp</item>
        <item name="android:layout_marginRight">2dp</item>
        <item name="android:paddingLeft">4dp</item>
        <item name="android:paddingRight">4dp</item>
        <item name="cornerRadius">18dp</item>
    </style>

    <style name="RemoteInputSpaceButton" parent="RemoteInputClickButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:textColor">?attr/colorOnPrimaryContainer</item>
        <item name="backgroundTint">?attr/colorPrimaryContainer</item>
        <item name="iconTint">?attr/colorOnPrimaryContainer</item>
        <item name="iconSize">18dp</item>
        <item name="iconPadding">2dp</item>
        <item name="iconGravity">textTop</item>
    </style>
    <style name="RemoteShortcutButton" parent="RemoteInputClickButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:focusableInTouchMode">false</item>
        <item name="backgroundTint">@color/remote_shortcut_background</item>
        <item name="android:textColor">@color/remote_shortcut_text</item>
    </style>
</resources>
