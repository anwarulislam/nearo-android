<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:paddingStart="24dp" android:paddingEnd="24dp"
    android:paddingTop="20dp" android:paddingBottom="8dp" android:orientation="vertical">
    <TextView android:id="@android:id/title"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="?attr/colorPrimary" android:textAppearance="?attr/textAppearanceTitleSmall" />
    <TextView android:id="@android:id/summary"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="?attr/colorOnSurfaceVariant" android:textAppearance="?attr/textAppearanceBodyMedium" />
</LinearLayout>
