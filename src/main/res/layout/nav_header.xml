<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="12dp"
        android:background="@drawable/nearo_identity_panel"
        android:orientation="vertical"
        android:padding="20dp">
        <ImageView
            android:id="@+id/device_type"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:importantForAccessibility="no"
            app:tint="@color/nearo_lime"
            tools:srcCompat="@drawable/ic_device_phone_32dp" />
        <TextView
            android:id="@+id/kdeconnect_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/nearo_app_name"
            android:textColor="@color/nearo_on_ink"
            android:textAppearance="?attr/textAppearanceHeadlineMedium" />
        <TextView
            android:id="@+id/device_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/nearo_on_ink"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            tools:text="My device" />
    </LinearLayout>
</FrameLayout>
