<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:background="@drawable/nearo_list_surface" android:orientation="vertical"
    android:paddingStart="28dp" android:paddingEnd="28dp" android:paddingTop="14dp" android:paddingBottom="4dp">
    <TextView android:id="@android:id/title"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textAppearance="?attr/textAppearanceTitleMedium" />
    <com.google.android.material.slider.Slider android:id="@+id/preference_slider"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:valueFrom="0" android:valueTo="100" android:stepSize="1"
        app:tickVisibilityMode="hidden" />
</LinearLayout>
